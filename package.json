{
  "name": "erg-viewer",
  "version": "3.0.0",
  "private": true,
  "description": "OptoERGViewer for OPTOPROBE Excel exports; plotting, annotation and export.",
  "author": "KangLab",
  "license": "UNLICENSED",
  "main": "src-v2/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps || true",
    "check:syntax": "node scripts/check_syntax.js",
    "check": "npm run check:syntax && npm run audit:control-styles && npm run audit:interactions && npm test && npm run smoke:v2 && npm run smoke:scientific-output && npm run smoke:project-repro",
    "smoke": "node scripts/smoke_parse.js",
    "smoke:v2": "node scripts/smoke_v2_workflow.js",
    "smoke:scientific-output": "node scripts/smoke_scientific_output.js",
    "smoke:project-repro": "node scripts/smoke_project_reproducibility.js",
    "smoke:visual-design-matrix": "node scripts/smoke_visual_design_matrix.js",
    "smoke:electron-export": "node scripts/smoke_electron_exports.js",
    "smoke:electron-state": "node scripts/smoke_electron_states.js",
    "smoke:electron-layout": "node scripts/smoke_electron_layout.js",
    "smoke:electron-design-audit": "node scripts/smoke_electron_design_audit.js",
    "smoke:electron-interactions": "node scripts/smoke_electron_interactions.js",
    "smoke:electron-role-review": "node scripts/smoke_electron_role_review.js",
    "smoke:electron-project-roundtrip": "node scripts/smoke_electron_project_roundtrip.js",
    "smoke:installed-app-roundtrip": "node scripts/smoke_installed_app_roundtrip.js",
    "smoke:installed-app-ui": "node scripts/smoke_installed_app_ui.js",
    "smoke:installed-visual-design-matrix": "node scripts/smoke_installed_visual_design_matrix.js",
    "smoke:installed-input-mode-matrix": "node scripts/smoke_installed_input_mode_matrix.js",
    "smoke:installed-control-response-matrix": "node scripts/smoke_installed_control_response_matrix.js",
    "smoke:installed-ui-spec-matrix": "node scripts/smoke_installed_ui_spec_matrix.js",
    "smoke:control-interaction-ledger": "node scripts/smoke_control_interaction_ledger.js",
    "smoke:mac-release-artifacts": "node scripts/smoke_macos_release_artifacts.js",
    "smoke:electron-quit": "node scripts/smoke_electron_quit.js",
    "audit:control-styles": "node scripts/audit-control-styles.js",
    "audit:interactions": "node scripts/audit-interactions.js",
    "gen:demo": "node scripts/gen-demo-data.js test-fixtures/opto",
    "lint": "eslint \"src-v2/**/*.{js,mjs}\"",
    "lint:fix": "eslint \"src-v2/**/*.{js,mjs}\" --fix",
    "format": "prettier --write \"src-v2/**/*.{js,mjs,html,css,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src-v2/**/*.{js,mjs,html,css,md}\" \"docs/**/*.md\"",
    "test": "vitest run src-v2",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac dmg zip --arm64",
    "build:win": "electron-builder --win nsis --x64",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:linux:deb": "electron-builder --linux deb --x64",
    "pack": "electron-builder --mac dmg zip --arm64",
    "pack:mac": "electron-builder --mac dmg zip --arm64",
    "pack:mac:x64": "electron-builder --mac dmg zip --x64",
    "pack:mac:arm64": "electron-builder --mac dmg zip --arm64",
    "pack:win": "electron-builder --win nsis",
    "pack:all": "electron-builder -mwl",
    "release:verify:mac": "node scripts/verify_macos_release.js",
    "gen:icons": "node scripts/gen-icons.js ./assets/app.png ./build/icons"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5",
    "plotly.js-dist-min": "^2.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.5",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.4",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "png2icons": "^2.0.1",
    "prettier": "^3.3.3",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "com.kanglab.ergviewer",
    "productName": "OptoERGViewer",
    "asar": true,
    "files": [
      "src-v2/**/*",
      "package.json",
      "README.md",
      ".editorconfig",
      "!node_modules/.cache/**",
      "!dist/**",
      "!*.xlsx",
      "!*.xls",
      "!**/*.map"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.medical",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "icon": "build/icons/icon.icns"
    },
    "fileAssociations": [
      {
        "ext": "ep",
        "name": "OptoERGViewer Project",
        "description": "OptoERGViewer project file",
        "role": "Editor"
      },
      {
        "ext": "ergproject",
        "name": "Legacy OptoERGViewer Project",
        "description": "Legacy OptoERGViewer project file",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "extraFiles": [
        {
          "from": "build/win/ffmpeg.dll",
          "to": "ffmpeg.dll"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science",
      "maintainer": "JunyanKang <JunyanKang@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "OptoERGViewer"
    }
  }
}
